{
  "name": "carburapp",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate.js && next build && node scripts/inject-sw-version.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "pnpm exec prisma db seed"
  },
  "packageManager": "pnpm@10.28.0",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "iron-session": "^8.0.4",
    "next": "16.3.4",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  }
}
